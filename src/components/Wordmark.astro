---
/**
 * Nombre del estudio en la tipografía display (se toma de src/data/site.ts).
 */
interface Props {
  size?: 'sm' | 'lg';
}
import { site } from '../data/site';
const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>{site.name}</span>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    letter-spacing: 0.005em;
  }

  .wordmark--sm {
    font-size: 1.65rem;
  }

  .wordmark--lg {
    font-size: var(--step-4);
  }
</style>
